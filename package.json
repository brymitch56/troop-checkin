{
  "name": "troop-checkin",
  "version": "0.4.14",
  "description": "Self-hosted youth sign-in/out kiosk for troops (Raspberry Pi, Windows, or Docker)",
  "private": true,
  "type": "commonjs",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "migrate": "node server/migrate.js",
    "create-staff": "node server/scripts/create-staff.js",
    "test": "node test/run.js",
    "make-roster": "node server/scripts/make-synthetic-roster.js",
    "backup": "node server/lib/backup.js",
    "sync-ical": "node -e \"require('./server/lib/icalSync').syncIcal().then(console.log, (e) => { console.error(e.message); process.exit(1); })\""
  },
  "engines": { "node": ">=18" },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "express": "^4.19.2",
    "multer": "^2.0.1",
    "node-ical": "^0.20.1",
    "xlsx": "^0.18.5"
  }
}
