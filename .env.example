# Troop Check-In configuration
# Copy to `.env` and fill in real values. `.env` is gitignored — never commit it.

# Port the Express server listens on.
PORT=3000

# Directory for all persistent data: SQLite DB, signature PNGs, roster upload
# archive, backups. Everything containing PII lives under this one directory.
# Default: ./data (relative to the repo root).
DATA_DIR=./data

# Optional: override the SQLite file path directly (default: $DATA_DIR/troop.db).
# DB_PATH=./data/troop.db

# NOTE: a brand-new install doesn't need to touch this file at all — start
# the app and open it in a browser; the /setup wizard writes .env for you.
# This file remains the reference for every option and for hand-editing.

# Troop identity shown in the UI and PWA manifest (keep the app shareable —
# no troop numbers hardcoded in source).
TROOP_ID=NY-0000
TROOP_NAME=Troop Check-In

# Color scheme. THEME picks a preset palette: traillife (default — pine
# green/blaze orange), ahg (navy), or generic (neutral slate). Individual
# colors can then be overridden on top of the preset with THEME_<VAR>=#RRGGBB
# (vars: PINE, PINE_2, PAPER, CARD, INK, MUTED, LINE, BLAZE, IN, FOCUS —
# see server/lib/theme.js). The /setup wizard writes these for you.
# Semantic colors keep their meaning: BLAZE = still-on-site, IN = signed-in.
# THEME=traillife
# THEME_PINE=#17402C

# Roster-portal display name (shown in the admin sync/import panels once the
# UI is label-driven): "Trail Life Connect", "AHGfamily", etc.
# ROSTER_SOURCE_NAME=Trail Life Connect

# In-process schedules — cross-platform replacement for systemd timers, so
# the same jobs run on Windows and in Docker with no OS scheduler at all.
# SCHEDULE_BACKUP: nightly (default; 03:15 local) | off
# SCHEDULE_ROSTER_SYNC: off (default) | weekly (Sun 03:30 local + jitter).
#   The Pi deployment keeps its systemd timer and leaves this unset.
# SCHEDULE_BACKUP=nightly
# SCHEDULE_ROSTER_SYNC=off

# Where this file lives (advanced; mainly Docker, where config must sit on a
# mounted volume). Set as a REAL environment variable, not here:
# ENV_FILE=/app/config/.env

# Timezone (any IANA zone; daylight-saving handled automatically). Drives the
# server's local-time logic: day-granular event past-rules, roster-fetch file
# names, the local_date() SQL function. If unset, the host OS timezone
# applies (on a Pi: sudo timedatectl set-timezone America/New_York). Times are
# STORED in UTC either way; phones always display in their own timezone.
TZ=America/New_York

# Trail Life Connect iCal feed URL for nightly event sync (Phase 2).
# All events are discrete (no recurrence rules).
ICAL_URL=https://example.com/your-troop-calendar.ics

# --- Phase 3: SMS notifications (disabled by default) -----------------------
# Master switch. Leave false until Twilio A2P 10DLC registration is approved —
# with it false, no SMS code runs at all.
SMS_ENABLED=false

# From Twilio Console (https://console.twilio.com) home page:
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# The Twilio phone number you bought, in +1 format:
# TWILIO_FROM_NUMBER=+15555550100

# Public HTTPS origin of this app (your Cloudflare tunnel hostname). Required
# for validating Twilio's inbound-webhook signatures. In the Twilio console,
# set the number's "A message comes in" webhook to <PUBLIC_URL>/api/sms/inbound
# PUBLIC_URL=https://checkin.example.org

# --- Automated roster sync (optional; docs/10-roster-sync.md) ---------------
# A weekly systemd timer (or the admin "Sync now" button) logs into Trail
# Life Connect, downloads the member export, and stages it as a PENDING
# import for one-tap approval in Admin -> Import. It NEVER commits by itself.
#
# Kill switch — set false to make every run a clean no-op:
TLC_ENABLED=false

# TLC login of an account that can see the member list. This file must be
# chmod 600 and is gitignored — credentials must never reach git or logs.
# MULTI-ROLE ACCOUNTS: TLC signs in under the account's LAST-USED role, and
# the export needs a role with member-list access (e.g. Troopmaster). Switch
# the account to that role in a browser before relying on the sync; a
# dedicated single-role account avoids the problem entirely.
# ALTERNATIVE (recommended): enter/update credentials in the app instead —
# Admin -> Import -> "Trail Life Connect credentials". Admin-saved credentials
# are ENCRYPTED AT REST (AES-256-GCM) in the database and take precedence
# over these two variables.
# TLC_EMAIL=troopmaster@example.com
# TLC_PASSWORD=change-me

# Encryption key for admin-saved credentials. DO NOT SET THIS BY HAND — the
# app generates it automatically on the first credential save and appends it
# to .env. It lives here (not under data/) on purpose: backups of the data
# directory then contain only ciphertext. If you ever lose this key, nothing
# breaks — the admin page tells you to re-enter the TLC password.
# CRED_KEY=<auto-generated, 64 hex chars>

# Where TLC lives and which export link to use. The defaults are correct as
# of July 2026; override only if TLC changes. Keep the xlsx export — it is
# the format the import parser was validated against.
# TLC_BASE=https://www.traillifeconnect.com
# TLC_EXPORT_PATH=/user/index?export=xlsx&new=0

# Safety guard: refuse a fetch whose row count dropped more than this
# fraction vs the last successful fetch (a stale TLC filter could silently
# return a partial roster; committing it would mass-deactivate members).
# 0.2 = refuse a >20% drop. Keep it strict.
# TLC_ROW_TOLERANCE=0.2

# Downloaded exports are PII: kept under data/roster-exports/ (mode 600,
# gitignored) and pruned after this many days.
# TLC_RETAIN_DAYS=56

# Optional success ping (e.g. a healthchecks.io URL) so a silently-broken
# weekly job pages you instead of failing quietly:
# HEALTHCHECK_URL=
